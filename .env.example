# Base URL of the _template_better-auth-backend Hono server. Read client-side
# (NEXT_PUBLIC_*), so it's inlined into the JS bundle at build time -- change
# it and restart `next dev`/rebuild, a running bundle won't pick it up live.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000

# This site's own public origin. Passed as the verification email's
# callbackURL (src/lib/auth-client.ts) so Better Auth's redirect after
# clicking the link lands on /verify-email here, not on the bare backend
# origin. Same NEXT_PUBLIC_* build-time-inlining caveat as above.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Comma-separated allowlist of hosts this server itself may be reached as.
# Enforced in src/proxy.ts -- if unset, proxy.ts rejects every request, so
# this is required, not optional, despite having no NEXT_PUBLIC_ prefix.
ALLOWED_HOSTS=localhost:3001

# SMTP config for the /contact page's API route (src/app/api/contact/route.ts).
# Sent server-side only, independent of the backend's own email setup -- if
# CONTACT_SMTP_HOST/USER/PASSWORD or CONTACT_TO_EMAIL are unset, the route
# responds 503 instead of silently failing.
CONTACT_SMTP_HOST=smtp.example.com
CONTACT_SMTP_PORT=587
CONTACT_SMTP_SECURE=false
CONTACT_SMTP_USER=
CONTACT_SMTP_PASSWORD=
CONTACT_TO_EMAIL=
# Defaults to CONTACT_SMTP_USER if unset.
CONTACT_FROM_EMAIL=
